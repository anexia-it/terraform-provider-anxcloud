# Choose a unique value for each run. It must be lowercase and at most 25 characters.
test_id = "kf-ake-e2e-01"

# Change this if ANX04 is not available to your organization.
location_code = "ANX04"

kubernetes_version   = "1.35"
external_ip_families = "IPv4"

# Waiting is safer for the initial end-to-end run. Set false to test asynchronous creation.
wait_until_ready = true

node_replicas      = 1
node_sync_source   = "engine"
node_cpus          = 2
node_memory_gib    = 4
node_disk_size_gib = 20

node_pool_network_bandwidth_limit = "1000"
